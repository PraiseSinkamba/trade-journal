# Rust build artifacts (covers both src-tauri/target/ and the gen_icons tool)
target/

# Tauri-generated schemas (regenerated by `tauri build` from tauri.conf.json)
gen/

# Sidecar binaries — downloaded by `pnpm setup:sidecar` (see desktop/README.md).
# Tauri picks up `binaries/node[-<target-triple>].exe` automatically.
binaries/*.exe
binaries/node

# Icons are reproducible from `cargo run --manifest-path scripts/gen_icons/Cargo.toml`
# (exposed as `pnpm icons` in desktop/package.json). Don't track outputs.
icons/*
!icons/.gitkeep
# Legacy duplicate of icons/ that snuck in during a prior move.
scripts/icons/*

# Scratch files that landed at the tauri project root during local testing.
*.ico
*.rc
*.res